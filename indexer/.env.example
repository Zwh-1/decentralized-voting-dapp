# Configuration for the indexer. Copy to `.env` and adjust.
# `.env` is git-ignored; this example file is not.

# MySQL connection URI. The indexer only ever reads from and writes to its own
# projection tables; it never touches the chain.
DATABASE_URL=mysql://root:CHANGE_ME@127.0.0.1:3306/voting

# Any JSON-RPC endpoint for the target chain. Public Sepolia endpoints work and
# need no API key, e.g. https://ethereum-sepolia-rpc.publicnode.com
RPC_URL=http://127.0.0.1:8545

# Chain the indexer follows. 31337 is Hardhat's local network, 11155111 Sepolia.
CHAIN_ID=31337

# Contract address. Optional: when omitted it is read from @voting/shared,
# which is populated by `pnpm --filter @voting/contracts export-abi`.
VOTING_ADDRESS=

# First block to scan. Leave empty to start from the current head.
START_BLOCK=

# Blocks to wait before treating a block as final. Guards against reorgs.
CONFIRMATIONS=5

# Maximum block span per getLogs call. Public RPCs cap this; 2000 is safe.
CHUNK_BLOCKS=2000

# Delay between polls when the indexer is caught up.
POLL_INTERVAL_MS=4000

# REST API port.
PORT=3001

LOG_LEVEL=info
