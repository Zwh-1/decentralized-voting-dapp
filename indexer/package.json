{
  "name": "@voting/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only event indexer and REST API for the Voting contract",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "drain": "node --env-file-if-exists=.env --import tsx src/cli/drain.ts",
    "check-consistency": "node --env-file-if-exists=.env --import tsx src/cli/check-consistency.ts",
    "test": "node --test --import tsx test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@voting/shared": "workspace:*",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "mysql2": "3.24.4",
    "pino": "10.3.1",
    "viem": "2.56.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.4",
    "pino-pretty": "13.1.3",
    "tsx": "4.20.6",
    "typescript": "~6.0.3"
  }
}
