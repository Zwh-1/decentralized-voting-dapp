# Environment for the containers, not for the app running from the repository.
#
#   cp .env.example .env      # then fill in the values
#
# `web/.env` is a different file with a different job: it configures `pnpm dev`
# and the scripts run straight from the checkout, where the database is the
# published 127.0.0.1:3307. Inside the compose network the host is `mysql` and the
# port is 3306, so the two files cannot be the same file.
#
# Nothing here is committed with a value. `HOSTNAME` is set by the image, and
# `PORT` too, so neither belongs in this file.

# Read-only chain access. The server degrades rather than crashes when this is
# unreachable, but /api/health will say so.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# How far behind the head a block must be before it is indexed. Reorg safety.
CONFIRMATIONS=5

# Blocks requested per RPC call while indexing.
CHUNK_BLOCKS=2000

# How often the indexer worker starts the next drain.
POLL_INTERVAL_MS=4000

# Set to true only for a process that should advance the index on its own. The
# compose file sets this to false on the web service and on the indexer service
# alike, so the indexer's own loop is driven by its entrypoint instead.
INDEXER_ENABLED=false

LOG_LEVEL=info

# Inside the compose network the database is reached by service name, which is
# what makes this different from the DATABASE_URL in web/.env.
DATABASE_URL=mysql://voting:voting@mysql:3306/voting

# Baked into the client bundle at image build time, so changing any of these
# requires rebuilding the image rather than restarting it.
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
