# 这是给**容器**用的环境变量，不是给"从仓库直接跑应用"用的。
#
#   cp .env.example .env      # 然后填值
#
# `web/.env` 是另一个文件、干另一件事：它配置的是 `pnpm dev` 和直接从检出目录
# 跑的脚本，那里的数据库是发布到宿主机的 127.0.0.1:3307。而在 compose 网络
# 内部，主机名是 `mysql`、端口是 3306，所以这两个文件**不可能是同一个文件**。
#
# 这里不允许带值提交。`HOSTNAME` 由镜像设置，`PORT` 也是，所以两者都不该出现在
# 这个文件里。

# 只读的链上访问。这个地址不通时，服务是降级而不是崩溃，
# 但 /api/health 会如实说出来。
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# 一个区块要落后链头多少块才被索引。用于防重组。
CONFIRMATIONS=5

# 索引时每次 RPC 请求取多少个区块。
CHUNK_BLOCKS=2000

# 索引器 worker 多久开始下一轮拉取。
POLL_INTERVAL_MS=4000

# 只有"应该自己推进索引"的进程才设为 true。
# compose 文件把 web 服务与 indexer 服务**都**设为 false，
# 因为 indexer 自己的循环是由它的 entrypoint 驱动的。
INDEXER_ENABLED=false

LOG_LEVEL=info

# 在 compose 网络内部，数据库用服务名访问 —— 这就是它与 web/.env 里那份
# DATABASE_URL 的区别。
DATABASE_URL=mysql://voting:voting@mysql:3306/voting

# 这几项在**构建镜像时**就被内联进前端 bundle，所以改动其中任何一项
# 都需要重新构建镜像，而不是重启容器。
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
