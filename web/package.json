{
  "name": "@voting/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Next.js app: the ballot UI plus the read-only indexer and its API routes",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/**/*.test.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "drain": "node --env-file-if-exists=.env --import tsx scripts/drain.ts",
    "check-consistency": "node --env-file-if-exists=.env --import tsx scripts/check-consistency.ts",
    "reorg-drill": "node --env-file-if-exists=.env --import tsx scripts/reorg-drill.ts",
    "refund-drill": "node --env-file-if-exists=.env --import tsx scripts/refund-drill.ts",
    "tamper-drill": "node --env-file-if-exists=.env --import tsx scripts/tamper-drill.ts",
    "commit-reveal-drill": "node --env-file-if-exists=.env --import tsx scripts/commit-reveal-drill.ts",
    "ui-drill": "node --env-file-if-exists=.env --import tsx scripts/ui-drill.ts",
    "ui-drill:change": "node --env-file-if-exists=.env --import tsx scripts/ui-drill.ts --change"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.3.7",
    "@tanstack/react-query": "5.103.1",
    "@walletconnect/ethereum-provider": "^2.25.0",
    "mysql2": "3.24.4",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.8",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "~6.0.3"
  }
}
