# Next.js 应用的配置。复制成 `.env` 后按需修改。
# `.env` 已被 git 忽略；这份示例文件不忽略。

# ---------------------------------------------------------------------------
# 链上访问（必需）。应用直接读合约来获取**不能出错**的那些数据：
# 所处阶段、你是否已投票、你的质押额、你是否在白名单里，
# 以及用于一致性比对的那个权威计票结果。
# ---------------------------------------------------------------------------

# 任意 JSON-RPC 端点。本地 `hardhat node` 就用下面的默认值。
#
# 这是**主**端点：它最先被尝试，出错信息里提到的也是它。
# 要加备用端点，设置下面的 `RPC_URLS`。
RPC_URL=http://127.0.0.1:8545

# 额外的端点，逗号分隔，在 RPC_URL 之后按顺序尝试。
#
# 可选。不设置就是本项目一直以来的单端点行为。设置之后，
# 某个端点失败时读取会重试下一个；并且索引器会停止把每个请求都发给
# 一个持续失败的端点 —— 没有这个机制的话，主端点挂掉后，
# 每一次读取都会先撞在它头上、付掉完整的超时，才能走到备用端点。
#
# **不要**把 RPC_URL 重复写在这里：它已经在第一位了，
# 而且重复项本来就会被不区分大小写地丢弃。
#
# 示例：
# RPC_URLS=https://ethereum-sepolia-rpc.publicnode.com,https://rpc.sepolia.org
RPC_URLS=

# 服务端从哪条链读数据。31337 是 Hardhat 本地网络，11155111 是 Sepolia。
CHAIN_ID=31337

# VotingFactory 的合约地址。可选：省略时会从 src/lib/contracts 里生成的注册表
# 读取，那张表由 `pnpm export-abi` 从 contracts/deployments/*.json 填充。
# 这样地址就只存在于一个地方。
#
# 这里**只**配置 factory。单个投票的地址是运行时由浏览器和索引器各自从
# factory 的 `PollCreated` 事件里发现的。把投票列在这里，
# 等于给"存在哪些投票"制造了第二个真相来源，任何人创建一个新投票它立刻就过期了。
FACTORY_ADDRESS=

# ---------------------------------------------------------------------------
# 可选的 MySQL 索引。DATABASE_URL 不设置应用照样能用：
# 每次读取都会退回直接读链，一致性徽章会显示"索引未启用"。
# 设置它才会启用索引器与双源比对。
# ---------------------------------------------------------------------------

# Docker Compose（推荐；见 docker-compose.yml）。那里故意用 3307 端口，
# 这样永远不会和已经监听 3306 的 MySQL 撞车：
# DATABASE_URL=mysql://voting:voting@127.0.0.1:3307/voting
#
# 或者指向你自己的 MySQL：
# DATABASE_URL=mysql://root:root@127.0.0.1:3306/voting

# 一个区块要被当作最终确认前需要等多少块。防重组。
CONFIRMATIONS=5

# 每次 getLogs 调用最多跨多少个区块。公共 RPC 有上限，2000 是安全值。
CHUNK_BLOCKS=2000

# 索引器轮询之间的间隔。
POLL_INTERVAL_MS=4000

# 服务启动时是否开启后台索引循环。如果你想自己驱动索引
# （`pnpm drain` 或 POST /api/index/sync），就设为 false。
INDEXER_ENABLED=true

# 游标为空时从哪个区块开始扫描。
#
# 留空则从合约部署的那个区块开始，该值取自 contracts/deployments/<chainId>.json
# （经由 `pnpm export-abi`）。这个默认值很重要：公共 RPC 会裁剪掉旧历史
# （Sepolia 最早可用的区块大约在 1,000,000 附近），所以从 0 开始扫描
# 会直接失败并报 `pruned history unavailable`，而不只是慢而已。
#
# 只有在需要从别的区块回填时才显式设置。注意它只在游标为空时生效 ——
# 它**不会**移动一个已存在的游标。
START_BLOCK=

# 这里曾经有一个 LOG_LEVEL=info，已删除：web/ 下没有任何一处读它。
# 留着一个不读的字段，只会让人以为调成 debug 能改变日志详细程度。

# ---------------------------------------------------------------------------
# 前端（可选）
# ---------------------------------------------------------------------------
# 浏览器自己去和链交互，它看不到服务端的 `RPC_URL` ——
# `NEXT_PUBLIC_*` 的值是在**构建时**内联进客户端 bundle 的，
# 所以下面这两个要生效都必须重新构建。

# 没有 `NEXT_PUBLIC_SEPOLIA_RPC_URL` 时，浏览器用 viem 自带的 Sepolia 端点。
# 当那个端点慢、或从读者所在网络访问不到时设置它，
# 也可以用它让浏览器读和服务端同一个节点。

# 覆盖读取选项元数据时优先使用的 IPFS 网关。公共网关限流很凶（HTTP 429），
# 所以建议用专用的。
#
# 这个值**必须以斜杠结尾**，这不是美观问题：相关模块请求的是
# `${gateway}${cid}`，所以不带斜杠的值会去请求 `…/ipfsbafk…`，
# 结果每个候选都返回 404。空值等于未设置。
# 只有元数据当初实际 pin 到的那个网关才能提供它：
# NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# 浏览器钱包访问本地链所用的 RPC。
#
# 和服务端的 `RPC_URLS` 一样，带 `_URLS` 的形式在单个端点之后追加备用端点，
# 是可选的。两端共用同一套排序规则（src/lib/rpc-endpoints.ts），
# 所以把两边配置成一样，浏览器与服务端的读取路径就一致。
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_LOCAL_RPC_URLS=

# 浏览器读取 Sepolia 所用的 RPC。
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# NEXT_PUBLIC_SEPOLIA_RPC_URLS=https://rpc.sepolia.org,https://sepolia.drpc.org
