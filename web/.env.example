# Configuration for the Next.js app. Copy to `.env` and adjust.
# `.env` is git-ignored; this example file is not.

# ---------------------------------------------------------------------------
# Chain access (required). The app reads the contract directly for the data it
# must not get wrong: phase, whether you voted, your stake, and the authoritative
# tally used for the consistency comparison.
# ---------------------------------------------------------------------------

# Any JSON-RPC endpoint. For a local `hardhat node` use the default below.
RPC_URL=http://127.0.0.1:8545

# Chain the server reads from. 31337 is Hardhat's local network, 11155111 Sepolia.
CHAIN_ID=31337

# Contract address. Optional: when omitted it is read from the generated
# registry in src/lib/contracts, which `pnpm export-abi` populates from
# contracts/deployments/*.json. That keeps the address in exactly one place.
VOTING_ADDRESS=

# ---------------------------------------------------------------------------
# Optional MySQL index. Leave DATABASE_URL unset and the app still works: every
# read falls back to direct chain access and the consistency badge reports that
# indexing is disabled. Set it to enable the indexer and the dual-source check.
# ---------------------------------------------------------------------------

# Docker Compose (recommended; see docker-compose.yml). Port 3307 is used there
# on purpose so it never collides with a MySQL already listening on 3306:
# DATABASE_URL=mysql://voting:voting@127.0.0.1:3307/voting
#
# Or point it at your own MySQL:
# DATABASE_URL=mysql://root:root@127.0.0.1:3306/voting

# Blocks to wait before treating a block as final. Guards against reorgs.
CONFIRMATIONS=5

# Maximum block span per getLogs call. Public RPCs cap this; 2000 is safe.
CHUNK_BLOCKS=2000

# Delay between indexer polls.
POLL_INTERVAL_MS=4000

# Start the background indexer loop when the server boots. Set to false when
# you would rather drive indexing yourself (`pnpm drain` or POST /api/index/sync).
INDEXER_ENABLED=true

# First block to scan when the cursor is empty.
#
# Leave it empty to start from the block the contract was deployed in, taken
# from `contracts/deployments/<chainId>.json` via `pnpm export-abi`. That default
# matters: public RPCs prune old history (Sepolia's earliest available block is
# around 1,000,000), so scanning from 0 fails with `pruned history unavailable`
# rather than merely being slow.
#
# Set it explicitly only to backfill from some other block. Note that it applies
# when the cursor is empty — it does not move an existing cursor.
START_BLOCK=

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Frontend (optional)
# ---------------------------------------------------------------------------

# Override the IPFS gateway used first for candidate metadata. Public gateways
# rate-limit aggressively (HTTP 429), so a dedicated one is recommended.
# NEXT_PUBLIC_IPFS_GATEWAY=https://your-gateway.example/ipfs/

# RPC the browser wallet talks to for the local chain.
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
