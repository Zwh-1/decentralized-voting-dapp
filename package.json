{
  "name": "decentralized-voting-dapp",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack decentralized voting dApp: Hardhat 3 + Solidity contracts, TypeScript event indexer backed by MySQL, React + wagmi frontend.",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm run build:contracts && pnpm run export-abi && pnpm run build:web",
    "build:contracts": "pnpm --filter @voting/contracts build",
    "build:web": "pnpm --filter @voting/web build",
    "export-abi": "pnpm --filter @voting/contracts export-abi",
    "test": "pnpm run test:contracts && pnpm run test:indexer",
    "test:contracts": "pnpm --filter @voting/contracts test",
    "test:indexer": "pnpm --filter @voting/indexer test",
    "typecheck": "pnpm --filter @voting/shared build && pnpm --filter @voting/indexer typecheck && pnpm --filter @voting/web typecheck",
    "coverage": "pnpm --filter @voting/contracts coverage",
    "gas": "pnpm --filter @voting/contracts gas",
    "deploy:local": "pnpm --filter @voting/contracts deploy:local",
    "deploy:sepolia": "pnpm --filter @voting/contracts deploy:sepolia",
    "seed:local": "pnpm --filter @voting/contracts seed:local",
    "indexer:migrate": "pnpm --filter @voting/indexer migrate",
    "indexer:start": "pnpm --filter @voting/indexer start",
    "indexer:drain": "pnpm --filter @voting/indexer drain",
    "indexer:check-consistency": "pnpm --filter @voting/indexer check-consistency",
    "web:dev": "pnpm --filter @voting/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.8"
  }
}
