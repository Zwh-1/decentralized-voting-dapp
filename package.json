{
  "name": "decentralized-voting-dapp",
  "version": "0.1.0",
  "private": true,
  "description": "Decentralized voting dApp in two layers: Hardhat 3 + Solidity contracts, and a Next.js app that serves both the ballot UI and a read-only event indexer over MySQL.",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm run build:contracts && pnpm run export-abi && pnpm run build:web",
    "build:contracts": "pnpm --filter @voting/contracts build",
    "build:web": "pnpm --filter @voting/web build",
    "export-abi": "pnpm --filter @voting/contracts export-abi",
    "test": "pnpm run test:contracts && pnpm run test:indexer",
    "test:contracts": "pnpm --filter @voting/contracts test",
    "test:indexer": "pnpm --filter @voting/web test",
    "typecheck": "pnpm --filter @voting/web typecheck",
    "coverage": "pnpm --filter @voting/contracts coverage",
    "gas": "pnpm --filter @voting/contracts gas",
    "deploy:local": "pnpm --filter @voting/contracts deploy:local",
    "deploy:sepolia": "pnpm --filter @voting/contracts deploy:sepolia",
    "seed:local": "pnpm --filter @voting/contracts seed:local",
    "indexer:migrate": "pnpm --filter @voting/web migrate",
    "indexer:drain": "pnpm --filter @voting/web drain",
    "indexer:check-consistency": "pnpm --filter @voting/web check-consistency",
    "indexer:reorg-drill": "pnpm --filter @voting/web reorg-drill",
    "indexer:refund-drill": "pnpm --filter @voting/web refund-drill",
    "ui:drill": "pnpm --filter @voting/web ui-drill",
    "web:dev": "pnpm --filter @voting/web dev",
    "web:start": "pnpm --filter @voting/web start",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.8"
  }
}
