# =============================================================================
# 服务器生产环境配置 —— 目标路径 /srv/voting/.env，权限 0600，属主 deploy
# =============================================================================
#
#   scp .env deploy@<服务器IP>:/srv/voting/.env
#   ssh deploy@<服务器IP> 'chmod 600 /srv/voting/.env'
#
# 这个文件只放在服务器上，**不进仓库**。
#
# 它对容器有两种作用，都不是"从仓库直接跑应用"：
#   1. `${VAR}` 插值 —— compose 解析文件时读它；
#   2. `env_file:` —— 把内容注入容器。
# 所以下面的 RPC_URL 与 CHAIN_ID **必须存在**：docker-compose.prod.yml 把它们写成
# `${RPC_URL:?}` / `${CHAIN_ID:?}`，缺任何一个，compose 会直接拒绝渲染（错误信息只
# 报变量名，不打印值）。这是刻意的——否则一个丢了 .env 的服务器会安静地退回
# 127.0.0.1:8545 与 chain 31337：页面照常渲染、投票数为 0，/api/health 仍返回 200，
# 于是健康门通过、部署报成功。
#
# 字段名以 docker-compose.yml / docker-compose.prod.yml 实际读取的为准，20 个字段
# 全部验证过：把占位符换成真值后 `docker compose -f docker-compose.yml -f
# docker-compose.prod.yml config`，渲染出的容器环境里每个字段都带着这里的值。
#
# -----------------------------------------------------------------------------
# 【请替换】标了「你定」的值请自己设置成强随机串
# -----------------------------------------------------------------------------

# --- 1. 链上读取 -------------------------------------------------------------
# 服务端用的 RPC。与浏览器用的 NEXT_PUBLIC_SEPOLIA_RPC_URL 是两个不同的值：
# 后者在构建时被内联进前端 bundle，这个只在容器里读。
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# 索引器落后链头多少块才算安全（防重组）
CONFIRMATIONS=5
# 每次 eth_getLogs 取多少块。公共 RPC 有上限，2000 是安全值
CHUNK_BLOCKS=2000
# 索引器循环间隔（毫秒）
POLL_INTERVAL_MS=4000

# 所有容器都设 false。索引由 indexer 这一个服务独占驱动——
# 第二个驱动者会和它抢同一个游标。
INDEXER_ENABLED=false

# 这里曾经有一个 LOG_LEVEL=info，已删除：web/ 下没有任何一处读它，
# 调成 debug 不会改变任何日志详细程度。把不生效的字段留在模板里，
# 只会让运维以为它起了作用（同样的理由删掉了旧的 VOTING_OWNER）。

# --- 2. 数据库 ---------------------------------------------------------------
# 主机名是 compose 的服务名 mysql，不是 127.0.0.1，也不是 3306:3307 的映射。
# 想用宿主机/外部已有的 MySQL，见仓库根目录的 docker-compose.external-db.yml：
# 那种情况下主机名改成 host.docker.internal 或那台机器的 IP。
#
# 【必须一致】DATABASE_URL 里的用户名/口令与下面的 MYSQL_USER/MYSQL_PASSWORD
# 必须是同一对值。后者由 docker-compose.yml 以 ${...} 插值读进去，用来初始化
# mysql 容器的库与账号；对不上不会报错，只表现为索引连不上库。
DATABASE_URL=mysql://voting:__SET_MYSQL_PASSWORD__@mysql:3306/voting

# 【已修】2026-09-23 之前这四个字段是空转的：docker-compose.yml 里写死了
# root/voting/voting，容器无论你在这里填什么都用写死的那份初始化——照着
# "口令必须与 DATABASE_URL 一致" 的说明填强口令，反而连不上。现在改为插值，
# 这里填什么就是什么。
MYSQL_ROOT_PASSWORD=【你定：root 口令】
MYSQL_DATABASE=voting
MYSQL_USER=voting
MYSQL_PASSWORD=【你定：数据库口令，与上面 DATABASE_URL 里的一致】

# --- 3. 监控导出器 -----------------------------------------------------------
# mysqld-exporter 专用账号的口令。故意与应用口令分开：
# 这个账号只有 PROCESS / REPLICATION CLIENT / performance_schema 的 SELECT，
# 没有读写投票数据的权限。建账号的 SQL 见 ops/server/README.md。
MYSQLD_EXPORTER_PASSWORD=【你定：exporter 口令】

# --- 4. Grafana --------------------------------------------------------------
# 注意：compose 里这个变量名是 GRAFANA_ADMIN_PASSWORD，
# 由它插值后以 GF_SECURITY_ADMIN_PASSWORD 传给 grafana 容器。
GRAFANA_ADMIN_PASSWORD=【你定：Grafana 管理口令】

# --- 5. 告警邮件（可选）------------------------------------------------------
# 这五项**要么全填、要么全留空**。
# ops/alertmanager/entrypoint.sh 渲染 alertmanager.yml.tmpl 时，
# 只要有一项为空就立即退出，容器起不来。
# 全留空 = 不上告警邮件通道，其它功能不受影响。
SMTP_SMARTHOST=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- 6. 镜像 ----------------------------------------------------------------
# 由 CI 的 deploy 步骤覆盖传入，正常情况下不用在这里改。
# 生产 compose 写的是 ${WEB_IMAGE:?}，缺失会直接报错而不是静默拉一个错的默认值。
WEB_IMAGE=【你定：如 yourname/voting-web】
WEB_IMAGE_TAG=latest
