# =============================================================================
# 服务器生产环境配置 —— 目标路径 /srv/voting/.env，权限 0600，属主 deploy
# =============================================================================
#
#   scp .env deploy@<服务器IP>:/srv/voting/.env
#   ssh deploy@<服务器IP> 'chmod 600 /srv/voting/.env'
#
# 这个文件只放在服务器上，**不进仓库**。仓库里有模板：.env.example
#
# 字段名以 docker-compose.yml 实际读取的为准（每个都在文件里标注了行号）。
#
# -----------------------------------------------------------------------------
# 【请替换】标了「你定」的值请自己设置成强随机串
# -----------------------------------------------------------------------------

# --- 1. 链上读取 -------------------------------------------------------------
# 服务端用的 RPC。与浏览器用的 NEXT_PUBLIC_SEPOLIA_RPC_URL 是两个不同的值：
# 后者在构建时被内联进前端 bundle，这个只在容器里读。
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# 索引器落后链头多少块才算安全（防重组）
CONFIRMATIONS=5
# 每次 eth_getLogs 取多少块。公共 RPC 有上限，2000 是安全值
CHUNK_BLOCKS=2000
# 索引器循环间隔（毫秒）
POLL_INTERVAL_MS=4000

# 所有容器都设 false。索引由 indexer 这一个服务独占驱动——
# 第二个驱动者会和它抢同一个游标。
INDEXER_ENABLED=false

LOG_LEVEL=info

# --- 2. 数据库 ---------------------------------------------------------------
# 主机名是 compose 的服务名 mysql，不是 127.0.0.1，也不是 3306:3307 的映射。
# 注意 MYSQL_PASSWORD 必须与这里 DATABASE_URL 里的口令逐字符一致。
DATABASE_URL=mysql://voting:__SET_MYSQL_PASSWORD__@mysql:3306/voting

# mysql 镜像首次初始化时读这三个
MYSQL_ROOT_PASSWORD=【你定：root 口令】
MYSQL_DATABASE=voting
MYSQL_USER=voting
MYSQL_PASSWORD=【你定：数据库口令，与上面 DATABASE_URL 里的一致】

# --- 3. 监控导出器 -----------------------------------------------------------
# mysqld-exporter 专用账号的口令。故意与应用口令分开：
# 这个账号只有 PROCESS / REPLICATION CLIENT / performance_schema 的 SELECT，
# 没有读写投票数据的权限。建账号的 SQL 见 ops/server/README.md。
MYSQLD_EXPORTER_PASSWORD=【你定：exporter 口令】

# --- 4. Grafana --------------------------------------------------------------
# 注意：compose 里这个变量名是 GRAFANA_ADMIN_PASSWORD，
# 由它插值后以 GF_SECURITY_ADMIN_PASSWORD 传给 grafana 容器。
GRAFANA_ADMIN_PASSWORD=【你定：Grafana 管理口令】

# --- 5. 告警邮件（可选）------------------------------------------------------
# 这五项**要么全填、要么全留空**。
# ops/alertmanager/entrypoint.sh 渲染 alertmanager.yml.tmpl 时，
# 只要有一项为空就立即退出，容器起不来。
# 全留空 = 不上告警邮件通道，其它功能不受影响。
SMTP_SMARTHOST=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- 6. 镜像 ----------------------------------------------------------------
# 由 CI 的 deploy 步骤覆盖传入，正常情况下不用在这里改。
# 生产 compose 写的是 ${WEB_IMAGE:?}，缺失会直接报错而不是静默拉一个错的默认值。
WEB_IMAGE=【你定：如 yourname/voting-web】
WEB_IMAGE_TAG=latest
