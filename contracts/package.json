{
  "name": "@voting/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voting smart contracts: Hardhat 3 + Solidity 0.8.x + OpenZeppelin 5",
  "scripts": {
    "build": "hardhat build",
    "clean": "hardhat clean",
    "test": "hardhat test",
    "test:solidity": "hardhat test solidity",
    "test:nodejs": "hardhat test nodejs",
    "coverage": "hardhat test --coverage",
    "gas": "hardhat test --gas-stats --gas-stats-json gas-stats.json",
    "export-abi": "hardhat run scripts/export-abi.ts",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify.ts --network sepoliaReadOnly",
    "verify:sourcify": "hardhat run scripts/verify-sourcify.ts",
    "seed:local": "hardhat run scripts/seed-local.ts --network localhost",
    "create-poll:sepolia": "hardhat run scripts/create-poll.ts --network sepolia",
    "verify:rules": "hardhat run scripts/verify-rules-hash.ts --network localhost",
    "pin:metadata": "hardhat run scripts/pin-metadata.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-network-helpers": "3.0.11",
    "@nomicfoundation/hardhat-node-test-runner": "3.1.0",
    "@nomicfoundation/hardhat-verify": "3.1.0",
    "@nomicfoundation/hardhat-viem": "3.0.9",
    "@nomicfoundation/hardhat-viem-assertions": "3.1.3",
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "^22.20.4",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "3.17.0",
    "typescript": "~6.0.3",
    "viem": "2.56.8"
  }
}
