# Configuration Variables for the `contracts` package.
#
# Hardhat 3 resolves these via `configVariable(...)` in hardhat.config.ts.
# You can either export them as environment variables, or store them
# encrypted with the keystore (recommended):
#
#   npx hardhat keystore set SEPOLIA_RPC_URL
#   npx hardhat keystore set SEPOLIA_PRIVATE_KEY
#
# Copy this file to `.env` and fill it in if you prefer plain env vars.
# `.env` is git-ignored; this example file is not.

# Any Sepolia JSON-RPC endpoint. Public endpoints work and need no API key:
#   https://ethereum-sepolia-rpc.publicnode.com
#   https://rpc.sepolia.org
SEPOLIA_RPC_URL=

# A DEDICATED throwaway deployer key. Never use a key that holds real funds.
# Fund it with Sepolia test ETH from a faucet before deploying.
SEPOLIA_PRIVATE_KEY=
