# Configuration Variables for the `contracts` package.
#
# Hardhat 3 resolves these via `configVariable(...)` in hardhat.config.ts.
# You can either export them as environment variables, or store them
# encrypted with the keystore (recommended):
#
#   npx hardhat keystore set SEPOLIA_RPC_URL
#   npx hardhat keystore set SEPOLIA_PRIVATE_KEY
#   npx hardhat keystore set ETHERSCAN_API_KEY
#
# Copy this file to `.env` and fill it in if you prefer a plain file.
# `hardhat.config.ts` loads `contracts/.env` explicitly, because Hardhat 3 does
# not read a `.env` file by itself. A variable exported in the shell wins over
# the file, so a one-off override still works.
# `.env` is git-ignored; this example file is not.

# Any Sepolia JSON-RPC endpoint. Public endpoints work and need no API key.
# These two were both measured returning chain id 11155111:
#   https://ethereum-sepolia-rpc.publicnode.com
#   https://1rpc.io/sepolia
# (rpc.sepolia.org was tried and answered HTTP 404, so it is not listed.)
SEPOLIA_RPC_URL=

# A DEDICATED throwaway deployer key. Never use a key that holds real funds.
# Fund it with Sepolia test ETH from a faucet before deploying.
#
# Needed only to deploy. `verify:sepolia` runs on the account-less
# `sepoliaReadOnly` network and does not read this variable.
SEPOLIA_PRIVATE_KEY=

# Free key from https://etherscan.io/myapikey — required only by `verify:sepolia`.
# Note that Etherscan's V2 API serves all supported chains from one key, so a
# single key covers Sepolia.
ETHERSCAN_API_KEY=

# Optional: make the contract administrator a different address than the
# deployer. Defaults to the deployer.
VOTING_OWNER=
